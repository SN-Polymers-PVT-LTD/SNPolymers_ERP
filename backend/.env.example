# Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct Postgres URI — only needed for the migration apply script (CI / local tooling)
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Direct connection" URI, not the pooler.
# Example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_TEST_DB_URI=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres


# JWT Credentials
JWT_SECRET=generate_a_secure_at_least_256_bit_secret_string
# Access token lifetime (e.g. 15m, 30m). Default: 15m
JWT_ACCESS_EXPIRY=15m
# Refresh token lifetime (e.g. 7d, 14d). Default: 7d
JWT_REFRESH_EXPIRY=7d

# Telegram Bot API Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram mode: 'polling' for local development, 'webhook' for production on Render
# Default (if unset): 'polling' in development, 'webhook' in production
TELEGRAM_MODE=polling

# Telegram Webhook settings (only needed when TELEGRAM_MODE=webhook)
WEBHOOK_URL=https://your-api.render.com
WEBHOOK_SECRET=your_custom_32_char_secret_token

# Nodemailer / Gmail SMTP Configuration
GMAIL_USER=your_gmail_sender@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=admin_notifications_receiver@domain.com

# Filter test data (e.g. TEST_% work orders) in production/non-test environments
IDBP_FILTER_TEST_DATA=true
